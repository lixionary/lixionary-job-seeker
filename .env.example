# Stack & Ports (proxied via Tailscale svc:job-seeker)
STACK_NAME=lixionary-job-seeker
HOST_BIND_IP=127.0.0.1
FRONTEND_PORT=9210
BACKEND_PORT=9211

# MongoDB (Internal Docker Network)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=job_radar

# MiniMax 3 / OpenAI-Compatible LLM Configuration
# MiniMax international endpoint: https://api.minimax.io/v1 (or https://api.minimaxi.com/v1)
# Leave LLM_API_KEY empty to use the built-in heuristic fallback scorer until ready.
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M1
LLM_TAILOR_MODEL=MiniMax-M1
MAX_LLM_SCORES_PER_RUN=50

# Optional Tier 2 Managed Job Aggregators (gracefully skipped if empty)
APIFY_TOKEN=
SERPAPI_KEY=

# Optional Daily Telegram Digest (gracefully skipped if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_PUBLIC_URL=https://job-seeker.fluffy-oratrice.ts.net
TZ=Asia/Jakarta
